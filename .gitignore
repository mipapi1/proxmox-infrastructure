# SSH private keys — never commit these
id_rsa
id_dsa
id_ecdsa
id_ecdsa_sk
id_ed25519
*.pem
*.key

# SSH public key used by Terraform — copy locally before running, do not commit
id_ed25519.pub
!id_ed25519.pub.example

# Terraform state — contains sensitive resource data
*.tfstate
*.tfstate.backup
crash.log

# Terraform plan files — can contain sensitive values
*.tfplan

# Terraform variable files — contain secrets
*.tfvars
!*.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform working directory and provider cache
.terraform/

# CLI configuration files
.terraformrc
terraform.rc

# Editor directories and files
.vscode/
.idea/
*.swp
*~

# OS files
.DS_Store

# Environment files
.env
.env.*
!.env.example
