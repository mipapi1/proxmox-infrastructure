proxmox_api_url      = "https://your-proxmox-host:8006/api2/json"
proxmox_api_token_id = "user@pve!token-name=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
pm_tls_insecure      = true

vms = {
  # ---------------------------------------------------------------
  # Single VM — downloads Ubuntu Noble cloud image, no template
  # ---------------------------------------------------------------
  vault = {
    name      = "vault-prod01"
    node_name = "proxmox03"
    ip        = "10.0.20.36/24"
    vcpu      = 1
    memory    = 2048
    disk_size = 64

    # Network — VLAN tag (omit for untagged)
    vlan_id = 20

    # SSH — primary admin user (defaults: ssh_username="papi", ssh_public_key_path="./id_ed25519.pub")
    # ssh_username        = "papi"
    # ssh_public_key_path = "./id_ed25519.pub"

    # Optional: additional users with keys provided as strings
    # ssh_additional_users = [
    #   {
    #     name                = "ansible"
    #     groups              = ["sudo"]
    #     ssh_authorized_keys = ["ssh-ed25519 AAAA... ansible@host"]
    #   }
    # ]
  }
}
