proxmox_api_url = "https://your-proxmox-host:8006/api2/json"
pm_tls_insecure = true

# proxmox_api_token_id is NOT set here — ./tf.sh pulls it from Vault
# (secret/proxmox/terraform, key api-token) and passes it as TF_VAR_proxmox_api_token_id.

ssh_public_keys = [
  "ssh-ed25519 AAAA... user@host",
]

vms = {
  k3s01 = {
    name           = "k3s-prod01"
    node_name      = "proxmox01"
    ip             = "10.0.20.11/24"
    vcpu           = 4
    memory         = 8192
    disk_size      = 100
    template_vm_id = 9000

    # Optional — VLAN tag, defaults to 20
    # vlan_id = 20
  }
}
